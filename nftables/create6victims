#!/bin/bash
# create-victims.sh

TEMPLATE="ubuntu-cloud-base"  # Replace with your template name
BASE_IMAGE="/var/lib/libvirt/images/${TEMPLATE}.qcow2"

# Create 6 victim VMs
for i in {1..6}; do
    VM_NAME="victim-${i}"
    
    echo "Creating ${VM_NAME} ..."
    
    # Create COW disk
    sudo qemu-img create -f qcow2 -F qcow2 -b ${BASE_IMAGE} \
        /var/lib/libvirt/images/${VM_NAME}.qcow2 25G
    
    # Create cloud-init config with static IP
    cat > /tmp/${VM_NAME}-user-data << EOF
#cloud-config
hostname: ${VM_NAME}
manage_etc_hosts: true
users:
  - name: galo
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ssh-rsa  bmounir@elite-hacker

packages:
  - nginx

runcmd:
  - systemctl enable nginx
  - systemctl start nginx

ssh_pwauth: true
password: victim123
chpasswd:
  expire: False
EOF
    
    touch /tmp/${VM_NAME}-meta-data
    sudo cloud-localds /var/lib/libvirt/images/${VM_NAME}-cidata.iso \
        /tmp/${VM_NAME}-user-data /tmp/${VM_NAME}-meta-data
    
    sudo virt-install \
        --name ${VM_NAME} \
        --memory 4096 \
        --vcpus 2 \
        --disk path=/var/lib/libvirt/images/${VM_NAME}.qcow2,format=qcow2 \
        --disk path=/var/lib/libvirt/images/${VM_NAME}-cidata.iso,device=cdrom \
        --os-variant ubuntu24.04 \
        --network network=packtnet \
        --import \
        --noautoconsole \
        --quiet

    echo "${VM_NAME} created"
done

echo "All 6 victim VMs created!"
